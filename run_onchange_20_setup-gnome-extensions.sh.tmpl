#!/usr/bin/env bash

set -uo pipefail

# Chezmoi hash trigger
{{- if contains "Bluefin" .chezmoi.osRelease.name }}
echo "Bluefin detected, configuring GNOME extensions..."

#----------Extensions----------#

EXTENSIONS=(
  "appindicatorsupport@rgcjonas.gmail.com"
  "bazaar-integration@kolunmi.github.io"
  "blur-my-shell@aunetx"
  "caffeine@patapon.info"
  "dash-to-dock@micxgx.gmail.com"
  "gradia-integration@alexandervanhee.github.io"
  "gsconnect@andyholmes.github.io"
  "search-light@icedman.github.com"
)

for ext in "${EXTENSIONS[@]}"; do
  if ! gnome-extensions enable "$ext" 2>/dev/null; then
    echo "Could not enable $ext, skipping..."
  fi
done

#----------Media Controller----------#

UUID="media-controller@naimur"
EXT_DIR="$HOME/.local/share/gnome-shell/extensions/${UUID}"

# Install and enable the latest Media Controller
if [ ! -d "$EXT_DIR" ]; then
    GNOME_RAW=$(gnome-shell --version)
    GNOME_VER=$(echo "$GNOME_RAW" | sed -E 's/[^0-9]*([0-9]+).*/\1/')
    DOWNLOAD_URI=$(curl -fsSL "https://extensions.gnome.org/extension-info/?uuid=${UUID}&shell_version=${GNOME_VER}" 2>/dev/null | jq -r '.download_url // empty' 2>/dev/null || true)
    if [ -n "$DOWNLOAD_URI" ]; then
        if curl -fsSL "https://extensions.gnome.org${DOWNLOAD_URI}" -o "/tmp/${UUID}.zip"; then
            gnome-extensions install --force "/tmp/${UUID}.zip" || echo "Failed to install ${UUID}, skipping..."
            rm -f "/tmp/${UUID}.zip"
        fi
    else
        echo "Media Controller is not available for GNOME ${GNOME_VER}, skipping..."
    fi
else
    echo "Media Controller already installed, skipping..."
fi

# Inject Media Controller into the extensions database
if [ -d "$EXT_DIR" ]; then
    CURRENT_EXTS=$(gsettings get org.gnome.shell enabled-extensions)
    if [[ "$CURRENT_EXTS" != *"$UUID"* ]]; then
        if [ "$CURRENT_EXTS" = "@as []" ] || [ "$CURRENT_EXTS" = "[]" ]; then
            gsettings set org.gnome.shell enabled-extensions "['${UUID}']"
        else
            gsettings set org.gnome.shell enabled-extensions "${CURRENT_EXTS%]*}, '${UUID}']"
        fi
    fi
fi

#----------Completion----------#

{{- else }}
echo "Bluefin not detected, skipping..."
{{- end }}
exit 0
