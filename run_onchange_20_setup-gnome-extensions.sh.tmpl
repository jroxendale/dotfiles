#!/usr/bin/env bash

set -euo pipefail

# Chezmoi hash trigger
{{- if contains "Bluefin" .chezmoi.osRelease.name }}
echo "Bluefin detected, configuring GNOME extensions..."

EXTENSIONS=(
  "appindicatorsupport@rgcjonas.gmail.com"
  "bazaar-integration@kolunmi.github.io"
  "blur-my-shell@aunetx"
  "caffeine@patapon.info"
  "dash-to-dock@micxgx.gmail.com"
  "gradia-integration@alexandervanhee.github.io"
  "gsconnect@andyholmes.github.io"
  "search-light@icedman.github.com"
)

for ext in "${EXTENSIONS[@]}"; do
  if ! gnome-extensions enable "$ext" 2>/dev/null; then
    echo "Could not enable $ext, skipping..."
  fi
done

# Fetch, install and enable the latest Media Controller
UUID="media-controller@naimur"

if [ ! -d "$HOME/.local/share/gnome-shell/extensions/${UUID}" ]; then
    GNOME_VER=$(gnome-shell --version | grep -oP '\d+' | head -n1)
    DOWNLOAD_URI=$(curl -s "https://extensions.gnome.org/extension-info/?uuid=${UUID}&shell_version=${GNOME_VER}" | jq -r '.download_url')

    if [ -n "$DOWNLOAD_URI" ] && [ "$DOWNLOAD_URI" != "null" ]; then
        curl -sL "https://extensions.gnome.org${DOWNLOAD_URI}" -o "/tmp/${UUID}.zip"
        gnome-extensions install --force "/tmp/${UUID}.zip"
        rm -f "/tmp/${UUID}.zip"
    else
        echo "Media Controller is not available, skipping..."
    fi 
else
    echo "Media Controller already installed, skipping..."
fi

# Inject Media Controller directly into the database
CURRENT_EXTS=$(gsettings get org.gnome.shell enabled-extensions)
if [[ "$CURRENT_EXTS" != *"$UUID"* ]]; then
    if [ "$CURRENT_EXTS" = "@as []" ] || [ "$CURRENT_EXTS" = "[]" ]; then
        gsettings set org.gnome.shell enabled-extensions "['${UUID}']"
    else
        gsettings set org.gnome.shell enabled-extensions "${CURRENT_EXTS%]*}, '${UUID}']"
    fi
fi

{{- else }}
echo "Bluefin not detected, skipping..."
{{- end }}
